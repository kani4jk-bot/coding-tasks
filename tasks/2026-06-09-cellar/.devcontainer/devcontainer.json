{
  "name": "cellar",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install -g eas-cli && npm install",
  "customizations": {
    "vscode": {
      "extensions": ["expo.vscode-expo-tools", "dbaeumer.vscode-eslint"]
    }
  },
  "forwardPorts": [8081, 19000, 19006]
}
