{
  "expo": {
    "name": "Cellar",
    "slug": "cellar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "cellar",
    "backgroundColor": "#17110F",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "bundleIdentifier": "com.kani4jk.cellar",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cellar uses the camera to photograph wine labels.",
        "NSPhotoLibraryUsageDescription": "Cellar lets you choose label photos from your library."
      }
    },
    "android": {
      "package": "com.kani4jk.cellar",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cellar lets you choose label photos from your library.",
          "cameraPermission": "Cellar uses the camera to photograph wine labels."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3583d273-7049-47a3-bbd5-1acd8fc5d22b"
      }
    },
    "owner": "camputy"
  }
}
